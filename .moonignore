# Publishing uses this file instead of .gitignore. Keep generated/private
# files out even when they exist locally and are not tracked by Git.
/_build/
/_target/
/target/
/.mooncakes/
/.venv/
**/__pycache__/
/artifacts/
/web/moonvision.js
/web/moonvision.js.map
/tools/real_bridge_runner.mjs
/项目申报书.md
/AGENTS.md
# README screenshots are served from the pinned GitHub tag. Keep actual
# offline image fixtures in web/samples for the examples and numerical tests.
/docs/images/
!/.moonignore
