        x_min: 3.0,
        y_min: 2.0,
        x_max: 4.0,
        y_max: 3.0,
        label: "edge",
      },
    ],
  }
  let expected = @moonaug.Sample::{
    image: @moonaug.Image::{
      width: 2,
      height: 3,
      channels: 3,
      data: [
        26, 33, 40, 47, 54, 61, 110, 117, 124, 131, 138, 145, 194, 201, 208, 215,
        222, 229,
