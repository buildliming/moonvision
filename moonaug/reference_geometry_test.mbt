///|
test "random pipeline: deterministic by seed and sample ID, replay exact" {
  let input = @moonaug.Sample::{
    image: @moonaug.Image::{
      width: 4,
      height: 3,
      channels: 3,
      data: [
        5, 12, 19, 26, 33, 40, 47, 54, 61, 68, 75, 82, 89, 96, 103, 110, 117, 124,
        131, 138, 145, 152, 159, 166, 173, 180, 187, 194, 201, 208, 215, 222, 229,
        236, 243, 250,
      ],
    },
    mask: Some([0, 0, 1, 1, 2, 3, 3, 1, 2, 2, 4, 4]),
    boxes: [
      @moonaug.BBox::{
        x_min: 0.25,
        y_min: 0.5,
        x_max: 3.6,
        y_max: 2.6,
        label: "main",
      },
      @moonaug.BBox::{
        x_min: 0.0,
        y_min: 0.0,
        x_max: 1.0,
        y_max: 1.0,
        label: "corner",
      },
      @moonaug.BBox::{
        x_min: 3.0,
        y_min: 2.0,
        x_max: 4.0,
        y_max: 3.0,
        label: "edge",
      },
    ],
  }
  let pipeline = [
    @moonaug.Step::{ transform: @moonaug.RandomCrop(3, 2), probability: 1.0, },
    @moonaug.Step::{ transform: @moonaug.HFlip, probability: 0.5, },
    @moonaug.Step::{ transform: @moonaug.VFlip, probability: 0.0, },
  ]
  let a = @moonaug.augment(input, pipeline, 20261025, "random-case")
  let b = @moonaug.augment(input, pipeline, 20261025, "random-case")
  assert_eq(a.sample.image.data, b.sample.image.data)
  assert_eq(
    @moonaug.replay_to_json(a.replay),
    @moonaug.replay_to_json(b.replay),
  )
  let restored = @moonaug.replay_from_json(@moonaug.replay_to_json(a.replay))
  let again = @moonaug.replay(input, restored)
  assert_eq(again.image.data, a.sample.image.data)
  assert_eq(again, a.sample)
}

///|
test "zero-probability steps preserve the independent input reference" {
  let input = @moonaug.Sample::{
    image: @moonaug.Image::{
      width: 4,
      height: 3,
      channels: 3,
      data: [
        5, 12, 19, 26, 33, 40, 47, 54, 61, 68, 75, 82, 89, 96, 103, 110, 117, 124,
        131, 138, 145, 152, 159, 166, 173, 180, 187, 194, 201, 208, 215, 222, 229,
        236, 243, 250,
      ],
    },
    mask: Some([0, 0, 1, 1, 2, 3, 3, 1, 2, 2, 4, 4]),
    boxes: [
      @moonaug.BBox::{
        x_min: 0.25,
        y_min: 0.5,
        x_max: 3.6,
        y_max: 2.6,
        label: "main",
      },
      @moonaug.BBox::{
        x_min: 0.0,
        y_min: 0.0,
        x_max: 1.0,
        y_max: 1.0,
        label: "corner",
      },
      @moonaug.BBox::{
        x_min: 3.0,
        y_min: 2.0,
        x_max: 4.0,
        y_max: 3.0,
        label: "edge",
      },
    ],
  }
  let pipeline = [
    @moonaug.Step::{ transform: @moonaug.RandomCrop(1, 1), probability: 0.0, },
    @moonaug.Step::{ transform: @moonaug.HFlip, probability: 0.0, },
    @moonaug.Step::{ transform: @moonaug.Rotate90(1), probability: 0.0, },
  ]
  let actual = @moonaug.augment(input, pipeline, 20261025, "skip-case")
  assert_eq(actual.sample, @moonaug.Sample::{
    image: @moonaug.Image::{
      width: 4,
      height: 3,
      channels: 3,
      data: [
        5, 12, 19, 26, 33, 40, 47, 54, 61, 68, 75, 82, 89, 96, 103, 110, 117, 124,
        131, 138, 145, 152, 159, 166, 173, 180, 187, 194, 201, 208, 215, 222, 229,
        236, 243, 250,
      ],
    },
    mask: Some([0, 0, 1, 1, 2, 3, 3, 1, 2, 2, 4, 4]),
    boxes: [
      @moonaug.BBox::{
        x_min: 0.25,
        y_min: 0.5,
        x_max: 3.6,
        y_max: 2.6,
        label: "main",
      },
      @moonaug.BBox::{
        x_min: 0.0,
        y_min: 0.0,
        x_max: 1.0,
        y_max: 1.0,
        label: "corner",
      },
      @moonaug.BBox::{
        x_min: 3.0,
        y_min: 2.0,
        x_max: 4.0,
        y_max: 3.0,
        label: "edge",
      },
    ],
  })
  assert_eq(actual.replay.operations.length(), 0)
}
