// Generated by verification/generate_references.py. Do not edit by hand.
// NumPy pixel permutations / PyTorch half-pixel resize / continuous box corners.

///|
fn reference_sample(
  got : @moonaug.Sample,
  expected : @moonaug.Sample,
  pixel_tolerance : Int,
) -> Unit raise {
  assert_eq(got.image.width, expected.image.width)
  assert_eq(got.image.height, expected.image.height)
  assert_eq(got.image.channels, expected.image.channels)
  assert_eq(got.image.data.length(), expected.image.data.length())
  for i = 0; i < got.image.data.length(); i = i + 1 {
    let delta = got.image.data[i].to_int() - expected.image.data[i].to_int()
    assert_true(delta >= -pixel_tolerance && delta <= pixel_tolerance)
    if got.image.channels == 4 && i % 4 == 3 {
      assert_eq(got.image.data[i], expected.image.data[i])
    }
  }
  assert_eq(got.mask, expected.mask)
  assert_eq(got.boxes.length(), expected.boxes.length())
  for i = 0; i < got.boxes.length(); i = i + 1 {
    let a = got.boxes[i]
    let b = expected.boxes[i]
    assert_eq(a.label, b.label)
    let delta = [
      a.x_min - b.x_min,
      a.y_min - b.y_min,
      a.x_max - b.x_max,
      a.y_max - b.y_max,
    ]
    for d in delta {
      assert_true(d >= -1.0e-10 && d <= 1.0e-10)
    }
  }
}

///|
test "independent geometry reference: horizontal_flip" {
  let input = @moonaug.Sample::{
    image: @moonaug.Image::{
      width: 4,
      height: 3,
      channels: 3,
      data: [
        5, 12, 19, 26, 33, 40, 47, 54, 61, 68, 75, 82, 89, 96, 103, 110, 117, 124,
        131, 138, 145, 152, 159, 166, 173, 180, 187, 194, 201, 208, 215, 222, 229,
        236, 243, 250,
      ],
    },
    mask: Some([0, 0, 1, 1, 2, 3, 3, 1, 2, 2, 4, 4]),
    boxes: [
      @moonaug.BBox::{
        x_min: 0.25,
        y_min: 0.5,
        x_max: 3.6,
        y_max: 2.6,
        label: "main",
      },
      @moonaug.BBox::{
        x_min: 0.0,
        y_min: 0.0,
        x_max: 1.0,
        y_max: 1.0,
        label: "corner",
      },
      @moonaug.BBox::{
        x_min: 3.0,
        y_min: 2.0,
        x_max: 4.0,
        y_max: 3.0,
        label: "edge",
      },
    ],
  }
  let expected = @moonaug.Sample::{
    image: @moonaug.Image::{
      width: 4,
      height: 3,
      channels: 3,
      data: [
        68, 75, 82, 47, 54, 61, 26, 33, 40, 5, 12, 19, 152, 159, 166, 131, 138, 145,
        110, 117, 124, 89, 96, 103, 236, 243, 250, 215, 222, 229, 194, 201, 208,
        173, 180, 187,
      ],
    },
    mask: Some([1, 1, 0, 0, 1, 3, 3, 2, 4, 4, 2, 2]),
    boxes: [
      @moonaug.BBox::{
        x_min: 0.3999999999999999,
        y_min: 0.5,
        x_max: 3.75,
        y_max: 2.6,
        label: "main",
      },
      @moonaug.BBox::{
        x_min: 3.0,
        y_min: 0.0,
        x_max: 4.0,
        y_max: 1.0,
        label: "corner",
      },
      @moonaug.BBox::{
        x_min: 0.0,
        y_min: 2.0,
        x_max: 1.0,
        y_max: 3.0,
        label: "edge",
      },
    ],
  }
  let actual = @moonaug.augment(
    input,
    [@moonaug.Step::{ transform: @moonaug.HFlip, probability: 1.0, }],
    20261025,
    "reference",
    min_visibility=0.0,
  )
  reference_sample(actual.sample, expected, 0)
  assert_eq(input, @moonaug.Sample::{
    image: @moonaug.Image::{
      width: 4,
      height: 3,
      channels: 3,
      data: [
        5, 12, 19, 26, 33, 40, 47, 54, 61, 68, 75, 82, 89, 96, 103, 110, 117, 124,
        131, 138, 145, 152, 159, 166, 173, 180, 187, 194, 201, 208, 215, 222, 229,
        236, 243, 250,
      ],
    },
    mask: Some([0, 0, 1, 1, 2, 3, 3, 1, 2, 2, 4, 4]),
    boxes: [
      @moonaug.BBox::{
        x_min: 0.25,
        y_min: 0.5,
        x_max: 3.6,
        y_max: 2.6,
        label: "main",
      },
      @moonaug.BBox::{
        x_min: 0.0,
        y_min: 0.0,
        x_max: 1.0,
        y_max: 1.0,
        label: "corner",
      },
      @moonaug.BBox::{
        x_min: 3.0,
        y_min: 2.0,
        x_max: 4.0,
        y_max: 3.0,
        label: "edge",
      },
    ],
  })
  let saved = @moonaug.replay_to_json(actual.replay)
  let restored = @moonaug.replay_from_json(saved)
  assert_eq(@moonaug.replay(input, restored), actual.sample)
}

