///|
test "independent PyTorch pyramid: binomial_1x2x1x7_False" {
  let input = @moonwarp.Tensor::new([1, 2, 1, 7], [
    0.819180953153521, 0.7184458628117436, 0.400440741678632, 1.1304708406569048,
    0.4213372750580737, -0.5357298849224077, 0.9374552910903275, 0.49541983137502,
    0.7244512466707518, -0.09448415931995968, -0.03013043477167643, 0.35918731760915623,
    0.8076784866972733, 0.5467767830475658,
  ])
  let output = @moonwarp.pyramid_downsample(input, align_corners=false)
  assert_eq(output.shape(), [1, 2, 1, 4])
  extended_close(output.data(), [
    0.7409571456101578, 0.6837848401084645, 0.42161591899347906, 0.43608031990022966,
    0.4727493246639502, 0.18644576439468588, 0.33151110091788494, 0.5857964875223955,
  ])
}

///|
test "independent PyTorch pyramid: binomial_1x2x1x7_True" {
  let input = @moonwarp.Tensor::new([1, 2, 1, 7], [
    0.819180953153521, 0.7184458628117436, 0.400440741678632, 1.1304708406569048,
    0.4213372750580737, -0.5357298849224077, 0.9374552910903275, 0.49541983137502,
    0.7244512466707518, -0.09448415931995968, -0.03013043477167643, 0.35918731760915623,
    0.8076784866972733, 0.5467767830475658,
  ])
  let output = @moonwarp.pyramid_downsample(input, align_corners=true)
  assert_eq(output.shape(), [1, 2, 1, 4])
  extended_close(output.data(), [
    0.7678259173508962, 0.6899268432598739, 0.3903052191284619, 0.5369016210851277,
    0.5158086857805168, 0.191561590041295, 0.3573505460678082, 0.6002778673700921,
  ])
}
