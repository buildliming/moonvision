///|
test "independent NumPy: matrix_batch_false" {
  let pixels = [
    1.2, 0.13, 2.1, -0.17, 0.93, -0.8, 0.59, -0.31, -0.2, 0.27, 1.17, 0.31,
  ]
  let theta = @moonwarp.pixel_affine_to_theta(
    pixels,
    3,
    5,
    4,
    2,
    align_corners=false,
  )
  extended_close(theta, [
    0.48, 0.10400000000000001, 0.35800000000000004, -0.11333333333333334, 1.24, -0.3266666666666669,
    0.236, -0.248, -0.9480000000000002, 0.18, 1.5599999999999998, 0.7999999999999999,
  ])
  extended_close(
    @moonwarp.theta_to_pixel_affine(theta, 3, 5, 4, 2, align_corners=false),
    pixels,
  )
  extended_close(@moonwarp.invert_theta(theta), [
    2.042878481679993, -0.17133819523767685, -0.787320973552412, 0.186714699938494,
    0.7907916703277391, 0.19148141639574745, 3.7790697674418605, 0.6007751937984498,
