///|
test "extended PyTorch: knots_ties_cycles_bilinear_zeros_false" {
  let input = @moonwarp.Tensor::new([1, 1, 2, 3], [
    1.0, 3.0, -2.0, 5.0, 7.0, 4.0,
  ])
  let grid = @moonwarp.Grid::new([1, 3, 5, 2], [
    -1.0, -0.13, -0.33333333333333337, -0.13, 0.33333333333333326, -0.13, 1.0, -0.13,
    -4.133333333333333, -3.9, 5.133333333333333, 3.7, -0.5333333333333334, -1.0,
    -0.5333333333333334, 0.0, -0.5333333333333334, 1.0, -0.6666666666666667, -0.5,
    0.6666666666666665, 0.5, -1.3333333333333333, -1.5, 1.333333333333333, 1.5, -1.0,
    -1.0, 1.0, 1.0,
  ])
  let output = @moonwarp.grid_sample(
    input,
    grid,
    align_corners=false,
    mode=@moonwarp.Bilinear,
    padding=@moonwarp.Zeros,
  )
  assert_eq(output.shape(), [1, 1, 3, 5])
  extended_close(output.data(), [
    1.24, 3.48, 2.3499999999999996, 0.10999999999999999, 0.0, 0.0, 0.6999999999999998,
    3.3999999999999995, 2.7, 0.9999999999999999, 4.0, 0.0, 0.0, 0.25, 1.0,
  ])
  let upstream = @moonwarp.Tensor::new([1, 1, 3, 5], [
    -0.63, -0.5014285714285714, -0.3728571428571429, -0.24428571428571433, -0.11571428571428577,
    0.01285714285714279, 0.14142857142857135, 0.27, 0.3985714285714286, 0.5271428571428571,
    0.6557142857142857, 0.7842857142857143, 0.9128571428571428, 1.0414285714285714,
    1.17,
  ])
  let grads = @moonwarp.grid_sample_backward(
    input,
    grid,
    upstream,
    align_corners=false,
    mode=@moonwarp.Bilinear,
    padding=@moonwarp.Zeros,
  )
  extended_close(grads.input_grad.data(), [
    0.5956714285714284, -0.23425714285714294, -0.19440000000000002, 0.05811428571428577,
    -0.09488571428571434, 0.8340428571428571,
  ])
  extended_close(grads.grid_grad.data(), [
    -2.3436, -1.26, -1.5042857142857144, -2.005714285714286, 2.382557142857143, -1.8642857142857143,
    0.08061428571428572, -0.732857142857143, 0.0, 0.0, 0.0, 0.0, 0.21214285714285702,
    0.19799999999999984, 0.81, 1.08, 0.5978571428571429, -2.1522857142857146, 0.7907142857142857,
    2.108571428571428, -3.934285714285714, -2.6228571428571428, 0.0, 8.70732057884587e-17,
    0.0, 0.0, 0.7810714285714285, 0.5207142857142857, -3.51, -2.34,
  ])
}

///|
test "extended PyTorch: singleton_bilinear_zeros_false" {
  let input = @moonwarp.Tensor::new([1, 2, 1, 1], [2.0, -3.0])
  let grid = @moonwarp.Grid::new([1, 1, 3, 2], [
    -1000.0, 1000.0, -0.4, 0.3, 1.2, -0.7,
  ])
  let output = @moonwarp.grid_sample(
    input,
    grid,
    align_corners=false,
    mode=@moonwarp.Bilinear,
    padding=@moonwarp.Zeros,
  )
  assert_eq(output.shape(), [1, 2, 1, 3])
  extended_close(output.data(), [
    0.0, 1.36, 0.5199999999999999, 0.0, -2.04, -0.7799999999999998,
  ])
  let upstream = @moonwarp.Tensor::new([1, 2, 1, 3], [
    -0.63, -0.27, 0.08999999999999997, 0.44999999999999996, 0.8099999999999999, 1.17,
  ])
  let grads = @moonwarp.grid_sample_backward(
    input,
    grid,
    upstream,
    align_corners=false,
    mode=@moonwarp.Bilinear,
    padding=@moonwarp.Zeros,
  )
  extended_close(grads.input_grad.data(), [
    -0.16020000000000004, 0.8549999999999999,
  ])
  extended_close(grads.grid_grad.data(), [
    0.0, 0.0, -1.2622499999999999, 1.1880000000000002, 1.08225, -0.6659999999999999,
  ])
}

