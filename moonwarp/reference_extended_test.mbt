///|
test "extended PyTorch: knots_ties_cycles_nearest_reflection_true" {
  let input = @moonwarp.Tensor::new([1, 1, 2, 3], [
    1.0, 3.0, -2.0, 5.0, 7.0, 4.0,
  ])
  let grid = @moonwarp.Grid::new([1, 3, 5, 2], [
    -1.5, -0.26, -0.5, -0.26, 0.5, -0.26, 1.5, -0.26, -6.2, -7.8, 7.699999999999999,
    7.4, -0.8, -2.0, -0.8, 0.0, -0.8, 2.0, -1.0, -1.0, 1.0, 1.0, -2.0, -3.0, 2.0,
    3.0, -1.5, -2.0, 1.5, 2.0,
  ])
  let output = @moonwarp.grid_sample(
    input,
    grid,
    align_corners=true,
    mode=@moonwarp.Nearest,
