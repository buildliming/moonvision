///|
test "PyTorch reference: singleton_output_axis_false" {
  let input = @moonwarp.Tensor::new([1, 1, 2, 3], [
    1.0, 2.0, 4.0, -1.0, 3.0, 5.0,
  ])
  let theta = [0.8, 0.2, 0.11, -0.1, 0.7, -0.09]
  let grid = @moonwarp.affine_grid(theta, 1, 1, 2, align_corners=false)
  assert_eq(grid.shape(), [1, 1, 2, 2])
  reference_close(grid.data(), [
    -0.29000000000000004, -0.039999999999999994, 0.51, -0.14,
  ])
  let output = @moonwarp.warp_affine(input, theta, 1, 2, align_corners=false)
  reference_close(output.data(), [1.4246999999999999, 3.8900000000000006])
  let upstream = @moonwarp.Tensor::new([1, 1, 1, 2], [0.9, -0.4])
  let grads = @moonwarp.warp_affine_backward(
    input,
    theta,
    upstream,
    align_corners=false,
  )
  reference_close(grads.input_grad.data(), [
    0.21141000000000004, 0.21443000000000004, -0.19584000000000004, 0.18009, 0.20007,
    -0.11016000000000002,
  ])
  reference_close(grads.theta_grad, [
    -2.2065, 0.0, 2.013, -0.06274999999999994, 0.0, -0.6745000000000001,
  ])
  let grid_grad = @moonwarp.Grid::new([1, 1, 2, 2], [
    3.213, -0.27450000000000013, -1.2000000000000002, -0.4,
  ])
  reference_close(
    @moonwarp.affine_grid_backward(grid_grad, align_corners=false),
    [-2.2065, 0.0, 2.013, -0.06274999999999994, 0.0, -0.6745000000000001],
  )
}

///|
test "PyTorch reference: singleton_output_axis_true" {
  let input = @moonwarp.Tensor::new([1, 1, 2, 3], [
    1.0, 2.0, 4.0, -1.0, 3.0, 5.0,
  ])
  let theta = [0.8, 0.2, 0.11, -0.1, 0.7, -0.09]
  let grid = @moonwarp.affine_grid(theta, 1, 1, 2, align_corners=true)
  assert_eq(grid.shape(), [1, 1, 2, 2])
  reference_close(grid.data(), [
    -0.6900000000000001, 0.010000000000000009, 0.91, -0.19,
  ])
  let output = @moonwarp.warp_affine(input, theta, 1, 2, align_corners=true)
  reference_close(output.data(), [0.7696499999999998, 4.2250000000000005])
  let upstream = @moonwarp.Tensor::new([1, 1, 1, 2], [0.9, -0.4])
  let grads = @moonwarp.warp_affine_backward(
    input,
    theta,
    upstream,
    align_corners=true,
  )
  reference_close(grads.input_grad.data(), [
    0.30739500000000003, 0.11668500000000001, -0.21658000000000005, 0.313605, 0.12631499999999998,
    -0.14742000000000005,
  ])
  reference_close(grads.theta_grad, [
    -3.0635000000000003, 0.0, 1.4635, 0.28150000000000014, 0.0, -0.6815000000000002,
  ])
  let grid_grad = @moonwarp.Grid::new([1, 1, 2, 2], [
    2.2635, -0.48150000000000015, -0.8, -0.2,
  ])
  reference_close(
    @moonwarp.affine_grid_backward(grid_grad, align_corners=true),
    [
      -3.0635000000000003, 0.0, 1.4635, 0.28150000000000014, 0.0, -0.6815000000000002,
    ],
  )
}
