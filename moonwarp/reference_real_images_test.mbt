// Generated from hash-verified offline photographs; no runtime image codec.
// See web/samples/ATTRIBUTION.md and verification/real_image_backend_reference.json.

///|
fn real_photo_close(
  actual : Array[Double],
  expected : Array[Double],
) -> Unit raise {
  assert_eq(actual.length(), expected.length())
  for i = 0; i < actual.length(); i = i + 1 {
    let delta = actual[i] - expected[i]
    assert_true(delta >= -1.0e-9 && delta <= 1.0e-9)
  }
}
